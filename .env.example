PORT=3000
NODE_ENV=production
PUBLIC_URL=https://app.vixan.com

# Superadmin que se crea en el primer arranque
ADMIN_EMAIL=admin@vixan.com
ADMIN_PASSWORD=cambiar-esta-clave

# App de Mercado Libre (developers.mercadolibre.com.ar)
ML_CLIENT_ID=
ML_CLIENT_SECRET=

# Ruta de la base (opcional)
# VIXAN_DB=/app/data/vixan.db

# WooCommerce: cada cuántos minutos sincroniza pedidos y stock (default 5)
# WOO_SYNC_MINUTOS=5

# Tienda online (Vixan Market): clave que comparten Vixan y la app vixan-tienda (mínimo 32 caracteres).
# Generala con: openssl rand -hex 32   — sin esta clave la API de tienda queda apagada.
# VIXAN_TIENDA_KEY=
# A dónde avisa Vixan cuando cambian stock o precios (la URL interna de la app de tienda)
# TIENDA_WEBHOOK_URL=http://127.0.0.1:3100/_vixan/aviso
# Dominio de los links de tienda (mitienda.vixan.com.ar)
# TIENDA_DOMINIO=vixan.com.ar
