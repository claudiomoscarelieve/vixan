PORT=3000
NODE_ENV=production
PUBLIC_URL=https://app.vixan.com

# Superadmin que se crea en el primer arranque
ADMIN_EMAIL=admin@vixan.com
ADMIN_PASSWORD=cambiar-esta-clave

# App de Mercado Libre (developers.mercadolibre.com.ar)
ML_CLIENT_ID=
ML_CLIENT_SECRET=

# Ruta de la base (opcional)
# VIXAN_DB=/app/data/vixan.db

# WooCommerce: cada cuántos minutos sincroniza pedidos y stock (default 5)
# WOO_SYNC_MINUTOS=5
